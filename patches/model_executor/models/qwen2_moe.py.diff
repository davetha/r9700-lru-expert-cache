+# Fuse the shared expert's sigmoid(gate) * out into one Triton launch.
+# 0 (default) keeps the stock two aten kernels; 1 fuses sigmoid+mul; 2 also folds
+# in the shared_expert_gate GEMV (one kernel for the whole tail, not bit-identical
+# -- see fused_gate_mul.py). Mode 2 only takes decode-sized row counts; wider
+# batches stay on hipBLASLt, which is the right kernel for them.
+_SHARED_GATE_MODE = int(os.environ.get("VLLM_FUSED_SHARED_GATE") or 0)
+FUSED_SHARED_GATE = _SHARED_GATE_MODE >= 1
+_SHARED_GATE_MAX_ROWS = int(os.environ.get("VLLM_FUSED_SHARED_GATE_MAX_ROWS") or 64)
+_FUSED_GATE_MUL: object = False
+
+
+def _fused_gate_mul():
+    """The fused kernel module, or None. Guarded: it only exists in the k4 patch
+    mount, and a missing mount must cost the fusion, not the model."""
+    global _FUSED_GATE_MUL
+    if _FUSED_GATE_MUL is False:
+        try:
+            from vllm.model_executor.layers import fused_gate_mul as _m
+        except ImportError:
+            _m = None
+            logger.warning(
+                "VLLM_FUSED_SHARED_GATE=1 but "
+                "vllm.model_executor.layers.fused_gate_mul is not mounted; "
+                "the shared expert gate stays on the two-kernel path.")
+        _FUSED_GATE_MUL = _m
+    return _FUSED_GATE_MUL
+
