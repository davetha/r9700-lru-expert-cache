+def _r4d_lru_fused(
+    topk_ids: torch.Tensor,
+    table: torch.Tensor,
+    map_cold: torch.Tensor,
+    slot_expert: torch.Tensor,
+    slot_stamp: torch.Tensor,
+    routed: torch.Tensor,
