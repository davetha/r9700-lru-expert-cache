+        if nb != _per_expert_bytes(d):
+            raise ValueError(f"lru gather: slab size mismatch {nb} vs {_per_expert_bytes(d)}")
+        args += [ctypes.c_void_p(d.data_ptr()), ctypes.c_void_p(s.data_ptr()),
+                 ctypes.c_long(nb)]
+    rc = _lru_lib().r4d_lru_gather(
+        *args, ctypes.c_void_p(miss.data_ptr()), ctypes.c_void_p(n_miss.data_ptr()),
+        chunks, lanes, ctypes.c_void_p(torch.cuda.current_stream().cuda_stream))
+    if rc != 0:
