+    npad_hot: torch.Tensor,
+    sorted_cold: torch.Tensor,
+    eids_cold: torch.Tensor,
+    npad_cold: torch.Tensor,
+    max_distinct: int,
+    max_inserts: int,
+    block_size: int,
