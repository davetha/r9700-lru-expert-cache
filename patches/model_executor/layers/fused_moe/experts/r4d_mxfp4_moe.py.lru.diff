+def _align_sizes(mk: int, num_experts: int, block_size: int) -> tuple[int, int]:
+    """The lengths vllm's moe_align_block_size wrapper allocates for `mk` (token, k) slots.
+    Must match exactly: the fused kernel fills both buffers end to end."""
+    n = mk + num_experts * (block_size - 1)
+    if mk < num_experts:
+        n = min(mk * block_size, n)
+    return n, (n + block_size - 1) // block_size
+
