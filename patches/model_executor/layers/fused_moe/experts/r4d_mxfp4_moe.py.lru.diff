+def _cfg_override(env: str, default, N: int, K: int):
+    v = os.environ.get(env, "")
+    if not v:
+        return default
+    wv, sk, npw = (int(x) for x in v.split(","))
+    assert K % (sk * GROUP) == 0 and wv * sk * 32 <= 1024 and npw in (1, 2, 4, 8) \
+        and wv * npw * sk * 1024 <= 64 * 1024, f"{env}={v} invalid for N={N} K={K}"
+    return (wv, sk, npw)
