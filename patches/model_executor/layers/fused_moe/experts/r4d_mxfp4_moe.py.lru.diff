+    """Everything r4d_lru_manage does, plus both moe_align_block_size outputs computed from
+    the table it just rewrote: 6 launches per layer become 2. Every element of all six
+    outputs is written on every call, including on a read-through or zero-miss step -- an
+    early exit there would leave the previous HIP-graph replay's values in place."""
+    import ctypes
+    rc = _lru_lib().r4d_lru_fused(
+        ctypes.c_void_p(topk_ids.data_ptr()), topk_ids.numel(), table.numel(),
+        slot_expert.numel(), max_distinct, max_inserts,
+        ctypes.c_void_p(table.data_ptr()), ctypes.c_void_p(map_cold.data_ptr()),
+        ctypes.c_void_p(slot_expert.data_ptr()), ctypes.c_void_p(slot_stamp.data_ptr()),
+        ctypes.c_void_p(routed.data_ptr()), ctypes.c_void_p(step.data_ptr()),
+        ctypes.c_void_p(miss.data_ptr()), ctypes.c_void_p(n_miss.data_ptr()),
+        block_size, sorted_hot.numel(), eids_hot.numel(),
+        ctypes.c_void_p(sorted_hot.data_ptr()), ctypes.c_void_p(eids_hot.data_ptr()),
+        ctypes.c_void_p(npad_hot.data_ptr()), ctypes.c_void_p(sorted_cold.data_ptr()),
+        ctypes.c_void_p(eids_cold.data_ptr()), ctypes.c_void_p(npad_cold.data_ptr()),
+        ctypes.c_void_p(torch.cuda.current_stream().cuda_stream))
