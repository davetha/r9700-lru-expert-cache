+def _r4d_lru_manage(
+    topk_ids: torch.Tensor,
+    table: torch.Tensor,
+    map_cold: torch.Tensor,
+    slot_expert: torch.Tensor,
+    slot_stamp: torch.Tensor,
+    routed: torch.Tensor,
+    step: torch.Tensor,
+    miss: torch.Tensor,
+    n_miss: torch.Tensor,
+    max_distinct: int,
+    max_inserts: int,
