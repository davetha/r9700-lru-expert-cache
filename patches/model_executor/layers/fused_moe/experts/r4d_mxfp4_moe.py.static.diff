 BLOCK = 16
 
+# ── Hot/cold expert residency (hot-experts patch, 2026-09-04) ─────────────────
+# With `--cpu-offload-params experts` the UVA offloader spills WHOLE per-layer expert
+# tensors first-come, so a layer is either 100% VRAM or 100% host and every routed read
+# in a spilled layer crosses PCIe. Routing is skewed (measured: the top-50% experts of a
+# layer take ~85% of decode routings), so instead: offload ALL expert tensors to host,
+# then at repack time gather each layer's most-used experts into a compact VRAM copy and
+# run the grouped GEMM twice — hot from VRAM, cold from the host tensor — into one
+# output buffer. Needs no kernel change: moe_align_block_size(ignore_invalid_experts=True)
+# with an expert_map emits local ids for one subset only, and the kernel writes only the
+# rows it is given.
+#   VLLM_R4D_HOT_PROFILE=/path.json  {"layers": {"<idx>": {"ranked": [expert ids, most
+#                                     used first], "counts": [...]}}}
+#   VLLM_R4D_HOT_GB=<float>          per-rank VRAM budget (GB, 1e9) for hot expert weights,
+#                                     spent globally on the highest-count (layer, expert)
+#                                     pairs — layers with flatter routing get fewer slots.
+import functools
+import json
+import os
+
+import numpy as np
+
+
+@functools.lru_cache
+def _hot_profile():
+    path = os.environ.get("VLLM_R4D_HOT_PROFILE")
+    if not path:
+        return None
+    with open(path) as f:
+        prof = json.load(f)["layers"]
+    return {int(k): (np.asarray(v["ranked"], dtype=np.int64),
+                     np.asarray(v["counts"], dtype=np.float64)) for k, v in prof.items()}
+
+
+@functools.lru_cache
+def _hot_sets(per_expert_bytes: int) -> dict[int, list[int]]:
+    """Global water-fill: spend the budget on the highest-count (layer, expert) pairs."""
+    prof = _hot_profile()
+    if prof is None:
+        return {}
+    gb = os.environ.get("VLLM_R4D_HOT_GB")
+    if gb is None:
+        raise ValueError("VLLM_R4D_HOT_PROFILE is set but VLLM_R4D_HOT_GB is not")
+    budget = int(float(gb) * 1e9) // per_expert_bytes
+    layers, ranked, counts = [], [], []
+    for li, (r, c) in prof.items():
+        tot = c.sum()
+        if tot <= 0:
+            raise ValueError(f"hot profile layer {li} has no routing counts")
+        layers.append(np.full(len(r), li)); ranked.append(r); counts.append(c / tot)
+    layers, ranked, counts = map(np.concatenate, (layers, ranked, counts))
+    keep = np.argsort(-counts, kind="stable")[:budget]
+    out: dict[int, list[int]] = {li: [] for li in prof}
+    for li, e in zip(layers[keep].tolist(), ranked[keep].tolist()):
+        out[li].append(e)
+    sizes = sorted(len(v) for v in out.values())
+    cov = float(sum(counts[keep])) / len(prof)
+    logger.info_once(
+        "r4d hot experts: budget %d experts/rank (%s GB) over %d layers -> per-layer "
+        "min/median/max %d/%d/%d, profile-estimated routing coverage %.3f",
+        budget, os.environ["VLLM_R4D_HOT_GB"], len(prof), sizes[0],
+        sizes[len(sizes) // 2], sizes[-1], cov)
+    return {li: sorted(v) for li, v in out.items()}
+
+
+def hot_ids_for_layer(layer_idx: int, per_expert_bytes: int) -> list[int] | None:
+    """None -> no profile configured or layer not profiled (single-call path)."""
+    if _hot_profile() is None:
+        return None
+    return _hot_sets(per_expert_bytes).get(layer_idx)
+
 
