+# Hand the fused GDN kernel strided views of the packed qkv instead of
+# repacking it (3 reshape copies + a torch.cat = 4 launches per GDN layer).
+# Needs the patched FLA kernel to be mounted too; 0 keeps the stock repack.
+GDN_STRIDED_QKV = os.environ.get("VLLM_GDN_STRIDED_QKV", "0") == "1"
+_FLA_STRIDED: bool | None = None
+
+
+def _fla_supports_strided_qkv() -> bool:
+    """Whether the mounted FLA kernel indexes q/k/v by a token stride.
+
+    Probed, not imported blind: with the stock kernel the strided views would
+    still be correct (its wrapper calls .contiguous()) but would buy nothing,
+    and a silent no-op is worse than a warning.
+    """
+    global _FLA_STRIDED
+    if _FLA_STRIDED is None:
+        from vllm.third_party.flash_linear_attention.ops import (
+            fused_sigmoid_gating as _fsg,
+        )
+
+        _FLA_STRIDED = bool(getattr(_fsg, "SUPPORTS_STRIDED_QKV", False))
+        if not _FLA_STRIDED:
+            logger.warning(
+                "VLLM_GDN_STRIDED_QKV=1 but the mounted fused_sigmoid_gating "
+                "kernel does not take q/k/v token strides; using the repack.")
+    return _FLA_STRIDED
+
