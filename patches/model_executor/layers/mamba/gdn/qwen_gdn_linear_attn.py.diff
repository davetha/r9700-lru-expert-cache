+    def rearrange_mixed_qkv_strided(self, mixed_qkv):
+        """Zero-copy [T, q+k+v] -> three (1, T, heads, dim) strided views.
+
+        Same tensors `rearrange_mixed_qkv` returns, minus the 4 copies: the
+        patched fused kernel walks q/k/v by a token stride, so the rows may sit
+        `mixed_qkv.stride(0)` apart instead of packed.
+        """
+        if mixed_qkv is None:
+            return None, None, None
+
+        seq_len = mixed_qkv.shape[0]
+        q_dim = self.key_dim // self.tp_size
+        k_dim = self.key_dim // self.tp_size
+        v_dim = self.value_dim // self.tp_size
+        row = mixed_qkv.stride(0)
+        col = mixed_qkv.stride(1)
+        base = mixed_qkv.storage_offset()
+
+        views = []
+        for off, dim, head_dim in (
+            (0, q_dim, self.head_k_dim),
+            (q_dim, k_dim, self.head_k_dim),
+            (q_dim + k_dim, v_dim, self.head_v_dim),
+        ):
+            views.append(
+                mixed_qkv.as_strided(
+                    (1, seq_len, dim // head_dim, head_dim),
+                    (seq_len * row, row, head_dim * col, col),
+                    base + off * col,
+                )
+            )
+        return tuple(views)
+
+    def _rearrange_for_fused(self, mixed_qkv):
+        """Decode paths only (the fused kernel); prefill keeps the repack."""
+        if GDN_STRIDED_QKV and _fla_supports_strided_qkv():
+            return self.rearrange_mixed_qkv_strided(mixed_qkv)
+        return self.rearrange_mixed_qkv(mixed_qkv)
+
