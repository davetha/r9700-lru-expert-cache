 logger = init_logger(__name__)
 
+# ROCm defaults the rms_norm IR priority to ["native"] whenever inductor is on, so the
+# decomposition can be fused (platforms/rocm.py:1130). The QSA indexer's GemmaRMSNorms
+# run in eager regions instead, where "native" means ~10 launched kernels per call and
+# nothing ever fuses them. Take the fused kernel there.
+#   0 = stock decomposition.
+#   1 = one fused kernel with (1 + w) rounded to x's dtype -- fastest, but the bf16
+#       weight rounding changes generated text (max rel 7.8e-3).
+#   2 = fp32-exact (default): cast x up, fuse in fp32, cast back -- 3 kernels. The
+#       weight is never rounded, but the fused kernel's fp32 variance reduction is
+#       not torch's, so ~3e-6 of output elements land one bf16 ulp away from stock
+#       (measured, k4/probe_gemma1.py). That is 5 orders of magnitude below mode 1.
+GEMMA_NORM_FUSED = int(os.environ.get("VLLM_GEMMA_NORM_FUSED") or 2)
+_FUSED_NORM_IMPL: dict[str, object] = {}
+
+
+def _fused_norm_impl(op):
+    """First supported non-native impl for `op`, in the platform's own preference
+    order, or None. Resolved once per op: `supported` is fixed at registration."""
+    impl = _FUSED_NORM_IMPL.get(op.name, False)
+    if impl is False:
+        impl = next(
+            (
+                i
+                for i in (op.impls.get(p) for p in ("aiter", "vllm_c", "oink"))
+                if i is not None and i.supported
+            ),
+            None,
+        )
+        _FUSED_NORM_IMPL[op.name] = impl
+    return impl
+
 
