+def cos_sin_halves(rope, x: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+    """Contiguous cos/sin halves of the rope cache.
+
+    ``cache[positions].chunk(2, -1)`` yields two strided views that triton_mrope
+    then has to ``.contiguous()``: one gather plus two copies. Splitting the cache
+    once turns that into two gathers with no copies. Costs one extra cache-sized
+    buffer (33 MB at 256K x 64), shared by every caller of this rope instance.
+    """
+    cache = rope._match_cos_sin_cache_dtype(x)  # noqa: SLF001
+    memo = getattr(rope, "_cos_sin_halves_memo", None)
+    if memo is None or memo[0] is not cache:
+        half = cache.shape[-1] // 2
+        memo = (cache, cache[..., :half].contiguous(), cache[..., half:].contiguous())
+        if torch.cuda.is_current_stream_capturing():
+            # Allocated in the capturing graph's private pool: correct for this graph, but
+            # must not be handed to another graph or to eager. Don't cache it.
+            return memo[1], memo[2]
+        rope._cos_sin_halves_memo = memo
+    return memo[1], memo[2]
+
