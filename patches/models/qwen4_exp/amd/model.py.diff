+# k2 patch (2026-09-04): opt-in UVA host offload for embed_tokens / visual.
+# See /home/dave/rocm10/patches/MOUNTS_K2.txt for the bind mount and env vars.
+from vllm.model_executor.offloader.base import should_pin_memory
+from vllm.utils.mem_utils import format_gib
