+# Probed by callers before they hand this function strided q/k/v: without the
+# patched kernel the stock wrapper still works, it just copies them first.
+SUPPORTS_STRIDED_QKV = True
+
+
+def _token_stride(t, heads: int, dim: int):
+    """Element stride between consecutive tokens of a [B, T, heads, dim] tensor,
+    or None when the (heads, dim) row is not contiguous and a copy is needed."""
+    if t.ndim != 4 or t.shape[2] != heads or t.shape[3] != dim:
+        return None
+    if t.stride(3) != 1 or t.stride(2) != dim:
+        return None
+    s = t.stride(1)
+    # bos folds batch and token together, so a batch must be exactly T tokens.
+    if t.shape[0] != 1 and t.stride(0) != t.shape[1] * s:
+        return None
+    return s
+
